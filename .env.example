# ============================================================================
# MIXOinteractive — ortam değişkenleri
# ============================================================================
#
# Bu dosya ŞABLON: değer içermez, hangi değişkenlerin gerektiğini gösterir.
# Repoda durur ve commit'lenir.
#
# Gerçek değerler `.env.local` dosyasına yazılır — o dosya .gitignore'da,
# asla commit'lenmez.
#
#   cp .env.example .env.local
#
# Vercel'e deploy ederken aynı değişkenleri proje ayarlarındaki
# Environment Variables panosuna da girmek gerekiyor.
# ============================================================================


# ---------------------------------------------------------------------------
# Firebase — İSTEMCİ tarafı
#
# Bunlar GİZLİ DEĞİL. Her Firebase web uygulaması bu değerleri tarayıcıya
# gönderir; kaynak koda bakan herkes görebilir ve bu beklenen davranış.
# Güvenlik bu anahtarları saklamaktan değil, Security Rules'tan gelir.
#
# Nereden: Firebase Console → Proje ayarları (dişli) → Genel
#          → "Uygulamalarınız" → Web uygulaması → SDK kurulumu ve yapılandırma
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase config'inde çıkan ama bizim kullanmadıklarımız:
#   storageBucket      → Firebase Storage kullanmıyoruz, fotoğraflar R2'de
#   messagingSenderId  → push bildirim yok
# Config'te görürsen kafan karışmasın, bilerek dışarıda bıraktım.


# ---------------------------------------------------------------------------
# Firebase — SUNUCU tarafı (Admin SDK)
#
# ⚠️ GİZLİ. Bu anahtar Security Rules'ı tamamen BYPASS eder, projeye tam
# yetkili erişim verir. Sohbete/mesaja yapıştırma, repoya koyma.
# Sızarsa: Firebase Console → Hizmet hesapları → anahtarı sil → yeni üret.
#
# Nereden: Firebase Console → Proje ayarları → Hizmet hesapları
#          → "Yeni özel anahtar oluştur" → inen JSON dosyası
#
# JSON'daki karşılıkları:
#   project_id    → FIREBASE_PROJECT_ID
#   client_email  → FIREBASE_CLIENT_EMAIL
#   private_key   → FIREBASE_PRIVATE_KEY
#
# PRIVATE_KEY çok satırlıdır. JSON'dan kopyaladığın hâliyle, içindeki
# \n karakterlerini BOZMADAN, çift tırnak içinde tek satır olarak yapıştır:
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# Koda okurken \n'leri gerçek satır sonuna ben çeviriyorum.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=


# ---------------------------------------------------------------------------
# Cloudflare R2 — fotoğraf deposu
#
# ⚠️ GİZLİ.
#
# Bucket PRIVATE kalmalı, public access açılmamalı: fotoğraflara erişim
# kısa ömürlü imzalı URL'lerle veriliyor (KVKK — 500 kişinin tanınabilir
# fotoğrafı, anahtarı bilen herkes okuyamamalı).
#
# Nereden: Cloudflare Dashboard → R2
#   R2_ACCOUNT_ID         → R2 genel bakış sayfasında sağda "Account ID"
#   R2_ACCESS_KEY_ID      → R2 → "Manage R2 API Tokens" → Create API Token
#   R2_SECRET_ACCESS_KEY     (bir kez gösterilir, kaydet) izin: Object Read & Write
#   R2_BUCKET             → oluşturduğun bucket adı
#   R2_ENDPOINT           → panelde yazan adres, BUCKET ADI OLMADAN
#
# ⚠️ R2_ENDPOINT'i Account ID'den TÜRETMİYORUZ. Bucket bir yargı bölgesinde
# (jurisdiction) oluşturulduysa adres değişiyor:
#     EU seçiliyse  → https://<hesap>.eu.r2.cloudflarestorage.com
#     varsayılan    → https://<hesap>.r2.cloudflarestorage.com
# Türetmek EU bucket'larda sessizce yanlış adrese gider, o yüzden elle veriliyor.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=


# ---------------------------------------------------------------------------
# OpenAI — görsel moderasyon
#
# ⚠️ GİZLİ.
#
# Sadece omni-moderation endpoint'i kullanılıyor. Fotoğrafın kendisi
# gönderilmiyor; R2'den üretilen kısa ömürlü imzalı URL gönderiliyor.
#
# Nereden: platform.openai.com → API keys → Create new secret key
# ---------------------------------------------------------------------------
OPENAI_API_KEY=


# ---------------------------------------------------------------------------
# Uygulama
#
# NEXT_PUBLIC_APP_URL: misafir QR linkleri ve davet mailleri bu adrese göre
# üretiliyor. Lokalde localhost, deploy'da gerçek adres.
#
# ⚠️ Telefonla QR okutup kamera açacaksan localhost YETMEZ: getUserMedia
# güvenli bağlam ister. Telefon http://192.168.x.x adresine bağlanırsa
# tarayıcı kamerayı reddeder. Telefon testi için HTTPS'li bir adres
# (Vercel preview ya da tünel) gerekiyor.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# Resend — mail (ERTELENDİ)
#
# Sadece organizatöre mail atıyor, misafire atmıyor. Domain doğrulaması
# (DNS TXT/DKIM) gerektirdiği için domain alınana kadar beklemede.
# Sırası gelince aşağıdaki satırların yorumunu kaldır.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM="MIXO <etkinlik@alanadin.com>"
